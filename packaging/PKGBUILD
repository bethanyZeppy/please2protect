license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3')

source=()

build() {
    cd "$GITHUB_WORKSPACE"
    cargo build --release --manifest-path src-tauri/Cargo.toml
}

package() {
    install -Dm755 "$GITHUB_WORKSPACE/src-tauri/target/release/Please2Protect" \
        "$pkgdir/usr/bin/Please2Protect"
}