pkgname=Please2Protect
pkgver=0.1.2
pkgrel=1
pkgdesc="APP TEST"
arch=('x86_64')
url="https://github.com/m4p4ch3Dev/Please2Protect"
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3')
source=("$pkgname-$pkgver.tar.gz::https://github.com/m4p4ch3Dev/Please2Protect/archive/refs/tags/app-v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$srcdir/Please2Protect-app-v$pkgver"
    cargo build --release --manifest-path src-tauri/Cargo.toml
}

package() {
    install -Dm755 "$srcdir/Please2Protect-app-v$pkgver/src-tauri/target/release/Please2Protect" \
        "$pkgdir/usr/bin/Please2Protect"
}
